[Unit]
Description=Podpivkovichi independent HTTPS endpoint
After=network-online.target podpivkovichi-app.service

[Service]
User=podpivkovichi-caddy
Group=podpivkovichi-caddy
WorkingDirectory=/var/lib/podpivkovichi-caddy
Environment=XDG_DATA_HOME=/var/lib/podpivkovichi-caddy
Environment=XDG_CONFIG_HOME=/var/lib/podpivkovichi-caddy
ExecStart=/opt/podpivkovichi/runtime/bin/caddy run --config /etc/podpivkovichi/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
StateDirectory=podpivkovichi-caddy
StateDirectoryMode=0700
UMask=0077
CPUQuota=10%
MemoryMax=128M
TasksMax=64
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/podpivkovichi-caddy

[Install]
WantedBy=multi-user.target
